# NyumbaSwift Environment Configuration

# Runtime mode: development or production
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./nyumbaswift.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nyumbaswift
AUTO_CREATE_TABLES=true

# Optional comma-separated browser origins when API and frontend are split
# CORS_ORIGINS=http://localhost:5173,https://nyumbaswift.vercel.app
CORS_ORIGINS=

# Comma-separated hostnames accepted by the API. Use explicit hosts in production.
ALLOWED_HOSTS=*

# JWT Secret — CHANGE THIS IN PRODUCTION
SECRET_KEY=nyumbaswift-dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# Rent collection fee (percentage)
RENT_COLLECTION_FEE_PERCENT=1.5

# Renter unlock fee (TZS)
RENTER_UNLOCK_FEE_TZS=5000

# Premium listing fee (TZS/month)
PREMIUM_LISTING_FEE_TZS=20000

# nTZS Partner API — required for rent payments, listing unlocks, and wallet
# Get your key at https://www.ntzs.co.tz
NTZS_BASE_URL=https://www.ntzs.co.tz
NTZS_API_KEY=
# Webhook secret — set this in your nTZS dashboard to the same value here
# Used to verify both /rentals/webhooks/ntzs and /wallet/webhooks/ntzs
NTZS_WEBHOOK_SECRET=

# Public base URL for webhook/dashboard callbacks
# Must be publicly reachable — nTZS posts to <PUBLIC_BASE_URL>/api/v1/wallet/webhooks/ntzs
PUBLIC_BASE_URL=https://nyumbaswift.vercel.app
