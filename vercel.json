{
  "version": 2,
  "builds": [
    {
      "src": "api/backend.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "index.html",
          "vite.svg",
          "favicon.svg",
          "apple-touch-icon.png",
          "icon-192.png",
          "icon-512.png",
          "site.webmanifest",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/backend.py"
    }
  ]
}
